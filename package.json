{
  "name": "concept-vault",
  "version": "0.1.0",
  "private": true,
  "description": "A desktop app for project-based document search, evidence matching, translation, and AI-assisted precise answers.",
  "author": "hhuan238-ai",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "dev": "vite",
    "electron": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "build:app": "npm run build && electron-packager . \"Concept Vault\" --platform=win32 --arch=x64 --out=release --overwrite --prune=true --ignore=\"^/release($|/)\" --ignore=\"^/\\.git($|/)\"",
    "build:dir": "npm run build && electron-builder --dir",
    "build:portable": "npm run build && electron-builder --win portable",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "^0.542.0",
    "mammoth": "^1.10.0",
    "openai": "^6.42.0",
    "pdfjs-dist": "^5.4.149",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-markdown": "^10.1.0",
    "rehype-katex": "^7.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "sql.js": "^1.13.0"
  },
  "devDependencies": {
    "@electron/packager": "^20.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12",
    "vite": "^7.1.3",
    "wait-on": "^8.0.4"
  },
  "build": {
    "appId": "com.local.conceptvault",
    "productName": "Concept Vault",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Concept Vault.exe"
    }
  }
}
